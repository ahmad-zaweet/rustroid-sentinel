# ------------------------------------------------------------------------------
# Rustroid Sentinel Environment Configuration
# ------------------------------------------------------------------------------
# Copy this file to .env and fill in your values
# Environment variables use double underscores (__) for nested keys

# The database connection URL for PostgreSQL.
# Replace with your actual username, password, host, port, and database name.
SERVICE__DATABASE__URL="postgresql://user:password@localhost:5432/rustroid_sentinel"
SERVICE__DATABASE__MAX_CONNECTIONS="10"

# User-agent used internally by our http clients.
SERVICE__HTTP__USER_AGENT="rustroid-sentinel"

# Optional: Runtime environment (development, production)
RUN_ENV="development"

# ------------------------------------------------------------------------------
# API Configuration (requires 'api' feature)
# ------------------------------------------------------------------------------
SERVICE__SERVER__REQUEST_TIMEOUT_SECONDS="300"
SERVICE__SERVER__RATE_LIMIT_REQUESTS="100"
SERVICE__SERVER__RATE_LIMIT_PERIOD_SECONDS="60"
SERVICE__SERVER__CACHE__ENABLED="true"

# ------------------------------------------------------------------------------
# ETL Configuration (requires 'etl' feature)
# ------------------------------------------------------------------------------
# Your NASA Open API Key.
# Obtain a free key from: https://api.nasa.gov/
SERVICE__NASA__API_KEY="DEMO_KEY"
SERVICE__NASA__BASE_URL="https://api.nasa.gov"

# ------------------------------------------------------------------------------
# Alerting Configuration (requires 'alerting' feature)
# ------------------------------------------------------------------------------
# Optional: The webhook endpoint for triggering Discord notifications
# when potentially hazardous asteroids approach Earth.
# Example: https://discord.com/api/webhooks/12345/abcde
SERVICE__DISCORD__WEBHOOK_URL=""
SERVICE__DISCORD__TIMEOUT_SECONDS="30"

# ------------------------------------------------------------------------------
# Prometheus/OTLP Metrics Configuration (Optional - requires 'metrics' feature)
# ------------------------------------------------------------------------------
# Metrics are pushed to Grafana Cloud via OTLP and exposed at /metrics for
# local Prometheus scraping. The dashboard can query from Grafana Cloud
# Prometheus API for real-time metrics.

# OTLP endpoint for pushing metrics to Grafana Cloud
# Example: https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# SERVICE__PROMETHEUS__URL="https://otlp-gateway-prod-eu-west-2.grafana.net/otlp"

# Prometheus Query API for dashboard metrics display (legacy, use grafana_cloud_prometheus instead)
# Example: https://prometheus-prod-eu-west-2.grafana.net/api/prom/api/v1/query
# SERVICE__PROMETHEUS__QUERY_URL="https://prometheus-prod-eu-west-2.grafana.net/api/prom/api/v1/query"

# Grafana Cloud credentials (instance ID and API token)
# SERVICE__PROMETHEUS__USERNAME="your-instance-id"
# SERVICE__PROMETHEUS__TOKEN="your-api-token"

# OTLP push interval in seconds (default: 60)
# SERVICE__PROMETHEUS__INTERVAL_SECONDS="60"

# ------------------------------------------------------------------------------
# Grafana Cloud Prometheus Querying Configuration (Optional)
# ------------------------------------------------------------------------------
# Dedicated configuration for querying Grafana Cloud Prometheus to display
# metrics on the dashboard. Uses separate credentials from OTLP push config.

# Grafana Cloud Prometheus Query API URL
# Example: https://prometheus-prod-eu-west-2.grafana.net/api/prom/api/v1/query
# SERVICE__GRAFANA_CLOUD_PROMETHEUS__URL="https://prometheus-prod-eu-west-2.grafana.net/api/prom/api/v1/query"

# Grafana Cloud instance ID (from Grafana Cloud portal)
# SERVICE__GRAFANA_CLOUD_PROMETHEUS__INSTANCE_ID="your-instance-id"

# Grafana Cloud API token with metrics:read permission
# SERVICE__GRAFANA_CLOUD_PROMETHEUS__TOKEN="your-api-token"
