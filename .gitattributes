# Auto-detect text files and normalize line endings
* text=auto

# Rust source
*.rs text diff=rust
*.toml text
*.lock text -diff

# Shell scripts
*.sh text eol=lf

# SQL
*.sql text

# Web assets
*.html text
*.css text
*.js text
*.json text

# Documentation
*.md text diff=markdown
*.yaml text
*.yml text

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
